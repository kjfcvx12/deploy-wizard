# 복사해서 .env 로 저장. .env 는 절대 커밋하지 않는다

# DB - 기본은 sqlite 파일. MySQL을 쓰려면 mysql+asyncmy://user:pw@host:3306/name
DB_URL=sqlite+aiosqlite:///./data/wizard.db

# AWS - 액세스 키를 여기에 적지 않는다. 프로파일 이름만
# 권장: aws login (브라우저 콘솔 로그인, AWS CLI 2.32.0+). 그냥 aws login 이면 비워 두고, aws login --profile <이름> 이면 그 이름
# 로그인할 때 고르는 리전은 아래 AWS_REGION 과 같게. 확인: python scripts/check_aws.py
AWS_PROFILE=
AWS_REGION=ap-northeast-2

# scripts/setup_roles.py 를 한 번 실행하면 출력되는 값
ECS_EXECUTION_ROLE_ARN=
ECS_INFRASTRUCTURE_ROLE_ARN=

# 서비스를 처음 만들 때 보낼 사양 (배포별로 고른 값이 있으면 그것이 먼저). 표기: ECS_CPU 는 CPU 단위 문자열, ECS_MEMORY 는 MiB 문자열 (예: 256 / 512 = 0.25 vCPU / 0.5 GB)
# 둘 다 적고 정해진 조합(256/512, 512/1024, 1024/2048, 2048/4096)일 때만 쓴다 - 한쪽만 있거나 다른 조합이면 무시하고 경고를 남긴다
# 비워 두면 보내지 않고 AWS 기본값을 쓴다 (실제 기본 크기는 아직 확인 전 - docs/aws-notes.md)
ECS_CPU=
ECS_MEMORY=

# LLM - 키는 ANTHROPIC_API_KEY 환경변수 또는 `ant auth login` 프로파일에서 SDK가 직접 찾는다
LLM_ENABLED=true
LLM_MODEL=claude-opus-5

BUILD_TIMEOUT_OFFICIAL=900
BUILD_TIMEOUT_EXPERIMENTAL=1800

# M6 - shared/secrets.py 암호화 키. 한 번 생성해서 고정. 바뀌면 저장된 값을 못 읽는다
# 생성: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=
# 로그인 - 키 회전: 새 SECRET_KEY 를 만들고, 예전 SECRET_KEY 는 여기에 쉼표로 이어 둔다(옛 암호문을 계속 읽는다)
SECRET_KEYS_OLD=
# 블라인드 인덱스(이메일·푸시 토큰 검색용 HMAC) 키 - 로그인을 끈 모드에서도 필요하다 (없으면 서버가 뜨지 않는다)
# SECRET_KEY·BLIND_INDEX_KEY 를 잃으면 암호화해 둔 값을 되살릴 수 없다. 생성: python -c "import secrets; print(secrets.token_urlsafe(48))"
BLIND_INDEX_KEY=
# 로그인 - 액세스 토큰(JWT) 서명 키. AUTH_ENABLED=true 일 때만 필요. 생성: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_JWT_KEY=
# 로그인 - true 로 켜면 모든 API 가 로그인을 요구한다 (SECRET_KEY·BLIND_INDEX_KEY 는 항상, AUTH_JWT_KEY 는 켤 때 있어야 서버가 뜬다)
AUTH_ENABLED=false
# 로그인 - 로그인을 허용할 이메일(쉼표로 구분)
AUTH_ALLOWED_EMAILS=
# 로그인 - HTTPS 로 서비스할 때 true (리프레시 쿠키에 Secure 속성)
AUTH_COOKIE_SECURE=false
# 로그인 - Google OAuth 클라이언트 ID (웹, 안드로이드)
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_ANDROID=

# M6 - GitHub App. github.com/settings/apps/new 에서 한 번 수동 등록 (scripts/setup_roles.py 와 같은 성격의 1회성 수동 단계)
# 권한은 최소로: Repository permissions - Contents: Read-only, Metadata: Read-only
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# 등록 시 발급되는 .pem 파일 경로. data/ 는 커밋하지 않는다
GITHUB_APP_PRIVATE_KEY_PATH=./data/github-app-private-key.pem
# 웹훅 설정에서 직접 정하는 값 (M6 watches 단계에서 서명 검증에 쓴다)
GITHUB_WEBHOOK_SECRET=

# M6 - watches 폴링 주기(초). 웹훅을 놓쳤을 때의 백업. 로컬에서 빨리 확인하려면 짧게
WATCH_POLL_SECONDS=3600
# M6 - 짧은 시간에 연속 푸시되면 이 시간(초)만큼 기다렸다가 마지막 커밋만 배포
WATCH_DEBOUNCE_SECONDS=30

# D1 - 헬스 감시 (running 이면서 주소가 있는 배포의 endpoint + health_check_path 에 GET). 끄면 예정 사용 시간 초과 알림도 같이 멈춘다 (같은 루프)
HEALTH_MONITOR_ENABLED=true
HEALTH_INTERVAL_SECONDS=60
# 마지막 성공 이후 연속 실패가 이 횟수에 닿으면 인시던트를 연다
HEALTH_FAILURE_THRESHOLD=3
HEALTH_TIMEOUT_SECONDS=10
# 헬스체크 기록을 이만큼(일) 보관
HEALTH_RETENTION_DAYS=7

# D1 - 자동 복구 한도 (자동으로 하는 것은 재시작과 직전 정상 이미지로 되돌리기 둘뿐). 배포별 스위치는 deploys.auto_recover
# 인시던트 하나당 자동 조치 횟수 (재시작 1 + 되돌리기 1)
RECOVERY_MAX_ATTEMPTS_PER_INCIDENT=2
# 배포 하나당 24시간 안의 자동 조치 횟수
RECOVERY_DAILY_LIMIT=6
# 조치 뒤 헬스를 다시 보기 전에 기다리는 시간(초)
RECOVERY_WAIT_SECONDS=120
# 이 시간(초) 안에 RECOVERY_VERIFY_OK_COUNT 번 연속 정상이면 복구된 것으로 본다
RECOVERY_VERIFY_SECONDS=300
RECOVERY_VERIFY_OK_COUNT=3
# 새 버전을 올린 직후 이 시간(초) 안의 문제는 나쁜 릴리스로 본다 (바로 되돌리기)
NEW_RELEASE_WINDOW_SECONDS=900

# D1 - 알림 메일(SMTP, STARTTLS). MAIL_HOST 또는 MAIL_TO 가 비어 있으면 메일은 꺼진다 (앱 안 알림·푸시는 그대로)
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_TO=
MAIL_TIMEOUT_SECONDS=10

# 비용 확인 - AWS 공개 가격 파일을 이 시간(시간)만큼 data/cache 에 두고 쓴다
PRICING_CACHE_HOURS=24
# 비용 확인 - 자동 증설 최대 작업 수 상한 (요금이 크게 늘지 않도록)
MAX_TASKS_CAP=4

# D1 - 앱 푸시(Expo)와 알림 본문에 넣을 앱 링크
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
EXPO_PUSH_TIMEOUT_SECONDS=10
APP_LINK_BASE=deploywizard://
