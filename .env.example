# 복사해서 .env 로 저장. .env 는 절대 커밋하지 않는다

# DB - 기본은 sqlite 파일. MySQL을 쓰려면 mysql+asyncmy://user:pw@host:3306/name
DB_URL=sqlite+aiosqlite:///./data/wizard.db

# AWS - 액세스 키를 여기에 적지 않는다. 프로파일 이름만
# 권장: aws login (브라우저 콘솔 로그인, AWS CLI 2.32.0+). 그냥 aws login 이면 비워 두고, aws login --profile <이름> 이면 그 이름
# 로그인할 때 고르는 리전은 아래 AWS_REGION 과 같게. 확인: python scripts/check_aws.py
AWS_PROFILE=
AWS_REGION=ap-northeast-2

# scripts/setup_roles.py 를 한 번 실행하면 출력되는 값
ECS_EXECUTION_ROLE_ARN=
ECS_INFRASTRUCTURE_ROLE_ARN=

# 비워 두면 Express Mode 기본값(1 vCPU / 2 GB)
ECS_CPU=
ECS_MEMORY=

# LLM - 키는 ANTHROPIC_API_KEY 환경변수 또는 `ant auth login` 프로파일에서 SDK가 직접 찾는다
LLM_ENABLED=true
LLM_MODEL=claude-opus-5

BUILD_TIMEOUT_OFFICIAL=900
BUILD_TIMEOUT_EXPERIMENTAL=1800

# M6 - shared/secrets.py 암호화 키. 한 번 생성해서 고정. 바뀌면 저장된 값을 못 읽는다
# 생성: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=

# M6 - GitHub App. github.com/settings/apps/new 에서 한 번 수동 등록 (scripts/setup_roles.py 와 같은 성격의 1회성 수동 단계)
# 권한은 최소로: Repository permissions - Contents: Read-only, Metadata: Read-only
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# 등록 시 발급되는 .pem 파일 경로. data/ 는 커밋하지 않는다
GITHUB_APP_PRIVATE_KEY_PATH=./data/github-app-private-key.pem
# 웹훅 설정에서 직접 정하는 값 (M6 watches 단계에서 서명 검증에 쓴다)
GITHUB_WEBHOOK_SECRET=

# M6 - watches 폴링 주기(초). 웹훅을 놓쳤을 때의 백업. 로컬에서 빨리 확인하려면 짧게
WATCH_POLL_SECONDS=3600
# M6 - 짧은 시간에 연속 푸시되면 이 시간(초)만큼 기다렸다가 마지막 커밋만 배포
WATCH_DEBOUNCE_SECONDS=30
